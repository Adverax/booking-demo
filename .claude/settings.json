{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/pre-push.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/pre-commit.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/post-edit.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/post-wave-done.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/post-adr-write.py"
          },
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/post-code-change.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/post-pull.py"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/agent-invocation.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/session-start.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/forge/prompt-language.py"
          }
        ]
      }
    ]
  }
}
